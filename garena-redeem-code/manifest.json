{
  "manifest_version": 3,
  "name": "DF Toolbox",
  "version": "1.9.3",
  "description": "Delta Force HQ credential bridge + Garena redeem codes",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://bot-klb-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DF Toolbox"
  },
  "content_scripts": [
    {
      "matches": [
        "https://redeem.df.garena.sg/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.playdeltaforce.com/*"
      ],
      "js": [
        "content/link-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/image.png",
    "48": "assets/image.png",
    "128": "assets/image.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/dashboard.css",
        "content/page-capture.js"
      ],
      "matches": [
        "https://redeem.df.garena.sg/*"
      ]
    },
    {
      "resources": [
        "content/link-page-capture.js",
        "content/dashboard.css"
      ],
      "matches": [
        "https://www.playdeltaforce.com/*"
      ]
    }
  ]
}
