{
  "manifest_version": 3,
  "name": "Pon1147 Redeem Tool",
  "version": "2.3.0",
  "description": "Auto redeem Garena codes - crafted by Pon1147",
  "permissions": [],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "*://redeem.df.garena.sg/*",
    "*://redeem.garena.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://redeem.df.garena.sg/*", "*://redeem.garena.com/*"],
      "js": [
        "core/utils.js",
        "core/config.js",
        "core/codes.js",
        "core/classifier.js",
        "core/state.js",
        "core/network.js",
        "core/dom.js",
        "core/redeem.js",
        "ui/icons.js",
        "ui/toast.js",
        "ui/panel.js",
        "core/app.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
