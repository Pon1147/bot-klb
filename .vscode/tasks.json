      "detail": "Run the Discord bot from compiled output"
    },
    {
      "label": "Dev (ts-node)",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "detail": "Run the Discord bot using ts-node (development)"
    },
    {
      "label": "Run Tests",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run Jest test suite"
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Run ESLint on src/"
    },
    {
      "label": "Lint Fix",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Run ESLint with auto-fix on src/"
    }
  ]
