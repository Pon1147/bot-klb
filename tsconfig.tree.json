{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "./",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "noEmitOnError": true
  },
  "include": ["tree.ts"],
  "exclude": ["node_modules", "tree.js"]
}